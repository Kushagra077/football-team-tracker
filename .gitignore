# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.claude
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build spec + working notes: local only, not published
notebooks/
A2-tracking-team-assignment-build-spec.md
PROGRESS.md
design_decision.md
INTERVIEW_NOTES.md

# SoccerNet data is never committed (NDA). Locally keep only tiny samples.
data/*
!data/README.md
!data/samples/
data/samples/*
!data/samples/.gitkeep

# Cached detector output / tracker output: regenerate with scripts/
cache/*
!cache/.gitkeep

# Evaluation outputs (MOT files, result json): regenerate with scripts/. Figures are kept.
reports/*
!reports/figures/

# Big artefacts
*.pt
*.onnx
*.mp4
runs/

# Input/showcase videos (copyrighted or large): local only
demo/
